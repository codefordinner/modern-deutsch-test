# Приложение само .env НЕ читает (dotenv не подключён): экспортируйте переменные в окружение,
# используйте docker/compose env или `node --env-file=.env ...` / `tsx --env-file=.env server.ts`.
# Пустое значение ("VAR=") — это НЕ "не задано": например, пустой TRUST_PROXY отключит доверие к прокси.
# Поэтому необязательные переменные закомментированы — раскомментируйте и задайте значение.

# --- Обязательно в production ---
# Пароль админки. Если не задан, действует пароль по умолчанию "admin" (в логе будет предупреждение).
ADMIN_PASSWORD=change-me
# Секрет подписи JWT: длинная случайная строка, одинаковая на всех экземплярах.
# Если не задан, ключ выводится из ADMIN_PASSWORD (слабее).
JWT_SECRET=change-me-to-a-long-random-string

# --- Необязательно ---
# База данных SQLite. По умолчанию file:./dev.db
# К URL автоматически добавляются connection_limit=1, socket_timeout=120, pool_timeout=120
# (можно переопределить: file:./dev.db?socket_timeout=300). При старте включается режим WAL.
# DATABASE_URL=file:./dev.db
# Доп. разрешённые Origin для CSRF-проверки, через запятую: https://example.com,https://www.example.com
# ALLOWED_ORIGINS=
# Сколько прокси стоит перед приложением (X-Forwarded-For). backend/ за nginx: 1 по умолчанию; server.ts: 0.
# TRUST_PROXY=1
# Часовой пояс «дня» в статистике посетителей (IANA). По умолчанию — часовой пояс сервера.
# STATS_TIMEZONE=Europe/Berlin
# Порт отдельного backend (index.ts). По умолчанию 3001. server.ts всегда слушает 3000.
# PORT=3001
# URL Piper внутри общей Podman-сети.
# PIPER_URL=http://piper-tts:5000
# PIPER_VOICE=de_DE-thorsten-medium
# Таймаут одного синтеза. На слабом CPU при массовой генерации лучше 60000–120000.
# PIPER_TIMEOUT_MS=30000
# Сколько слов синтезируется параллельно при массовой регенерации (1–8, по умолчанию 2).
# AUDIO_REGEN_CONCURRENCY=2
