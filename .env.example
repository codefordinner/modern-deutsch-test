# Приложение само .env НЕ читает (dotenv не подключён): экспортируйте переменные в окружение,
# используйте docker/compose env или `node --env-file=.env ...` / `tsx --env-file=.env server.ts`.
# Пустое значение ("VAR=") — это НЕ "не задано": например, пустой TRUST_PROXY отключит доверие к прокси.
# Поэтому необязательные переменные закомментированы — раскомментируйте и задайте значение.

# Секрет для локальной автоматизации Hermes (Bearer-токен, не публиковать).
# HERMES_WORD_IMPORT_TOKEN=generate-a-long-random-token

# --- Авторизация учеников через Telegram ---
# Runtime secret: backend проверяет Mini App initData, общий бот получает updates (сейчас только вход).
# TELEGRAM_BOT_TOKEN=replace-with-secret
# Публичный username общего Sprachfunke-бота без @.
# TELEGRAM_BOT_USERNAME=your_auth_bot
# Отдельный случайный секрет bot → backend. Не использовать Telegram bot token.
# TELEGRAM_BOT_API_SECRET=replace-with-another-long-random-secret
# Отдельный pepper для keyed digest одноразовых кодов и browser binding.
# TELEGRAM_AUTH_PEPPER=replace-with-a-third-long-random-secret
# Максимальный возраст Mini App initData в секундах (по умолчанию 300).
# TELEGRAM_INIT_DATA_MAX_AGE_SECONDS=300
# Срок пользовательской сессии в секундах (по умолчанию 30 дней).
# TELEGRAM_SESSION_TTL_SECONDS=2592000
# Принудительно ставить Secure cookie за HTTPS tunnel, даже если внутренний proxy говорит HTTP.
# В production secure-cookie включён автоматически; локально не задавать.
# TELEGRAM_COOKIE_SECURE=true

# --- Необязательно ---
# База данных SQLite. По умолчанию file:./dev.db
# К URL автоматически добавляются connection_limit=1, socket_timeout=120, pool_timeout=120
# (можно переопределить: file:./dev.db?socket_timeout=300). При старте включается режим WAL.
# DATABASE_URL=file:./dev.db
# Доп. разрешённые Origin для CSRF-проверки, через запятую: https://example.com,https://www.example.com
# ALLOWED_ORIGINS=
# Сколько прокси стоит перед приложением (X-Forwarded-For). backend/ за nginx: 1 по умолчанию; server.ts: 0.
# TRUST_PROXY=1
# Часовой пояс «дня» в статистике посетителей (IANA). По умолчанию — часовой пояс сервера.
# STATS_TIMEZONE=Europe/Berlin
# Порт отдельного backend (index.ts). По умолчанию 3001. server.ts всегда слушает 3000.
# PORT=3001
# URL Piper внутри общей Podman-сети.
# PIPER_URL=http://piper-tts:5000
# PIPER_VOICE=de_DE-thorsten-medium
# Таймаут одного синтеза. На слабом CPU при массовой генерации лучше 60000–120000.
# PIPER_TIMEOUT_MS=30000
# Сколько слов синтезируется параллельно при массовой регенерации (1–8, по умолчанию 2).
# AUDIO_REGEN_CONCURRENCY=2
# Максимальное число одновременных запросов Gemini (по умолчанию 2).
# AI_QUEUE_CONCURRENCY=2
# Дневной лимит платных проверок ответов ИИ (Gemini) на весь сервер. По умолчанию 500.
# AI_DAILY_CHECK_CAP=500
