generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Category {
  id         String   @id @default(cuid())
  name       String
  normalizedName String?
  icon       String?
  color      String?
  isBuiltin  Boolean  @default(false)
  /// Words whose PRIMARY category this is (Word.categoryId).
  words      Word[]   @relation("PrimaryCategory")
  /// Words that additionally belong to this category (many-to-many).
  extraWords Word[]   @relation("WordExtraCategories")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  @@unique([normalizedName])
}

model Word {
  id              String   @id @default(cuid())
  de              String
  normalizedDe    String?
  ru              String
  hint            String?
  /// noun | verb | adjective | adverb | other. Validated in the API (SQLite has no enums in Prisma 5).
  /// null = not specified; the API infers it on save, see src/services/partOfSpeech.ts.
  partOfSpeech    String?
  plural          String?
  feminine        String?
  praeteritum     String?
  partizip2       String?
  hilfsverb       String?
  praesensIch     String?
  praesensDu      String?
  praesensErSieEs String?
  praesensWir     String?
  praesensIhr     String?
  praesensSie     String?
  /// Case typically required by the verb: nominativ | akkusativ | dativ | genitiv.
  requiredCase    String?
  /// PRIMARY category (the first of the word's categories). Kept as a plain column so existing data
  /// needs no migration; the rest of the word's categories are in `extraCategories`.
  categoryId      String
  category        Category   @relation("PrimaryCategory", fields: [categoryId], references: [id], onDelete: Cascade)
  /// Additional categories. The API exposes primary + extras as one list (`categories` / `categoryIds`).
  extraCategories Category[] @relation("WordExtraCategories")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  @@unique([normalizedDe])
}

model AnalyticsEvent {
  id          String   @id @default(cuid())
  eventType   String
  trainerType String?
  isCorrect   Boolean?
  /// Telegram learner's internal id for authenticated events; null for historical anonymous events.
  learnerId   String?
  /// Legacy random id from the long-lived `visitor_id` cookie.
  visitorId   String?
  ipAddress   String?
  userAgent   String?
  browser     String?
  os          String?
  device      String?
  timestamp   DateTime @default(now())

  @@index([eventType, timestamp])
  @@index([learnerId, timestamp])
}

/// Server-wide settings edited in the admin panel (key → JSON-encoded value).
/// Currently: "srsBoxWeights" — see src/services/srsSettings.ts.
model Setting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

/// Diagnostic records for AI provider calls. Prompt/response traces are stored for administrator debugging;
/// the logging service redacts API keys and inline image data before saving them.
model AiErrorLog {
  id             String   @id @default(cuid())
  operation      String
  profileId      String?
  model          String?
  errorCode      String
  providerStatus Int?
  message        String
  prompt        String?
  response      String?
  durationMs     Int?
  createdAt      DateTime @default(now())

  @@index([createdAt])
  @@index([operation, createdAt])
}

/// Generated speech audio. The same table supports individual words today and
/// complete sentences later; `cacheKey` includes the text and TTS settings.
model AudioCache {
  id        String   @id @default(cuid())
  cacheKey  String   @unique
  kind      String   // word | sentence
  text      String
  audio     Bytes
  mimeType  String   @default("audio/wav")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([kind])
}

/// Durable status of the administrator's background word-audio regeneration.
/// There is at most one active job; progress survives a browser refresh.
model AudioRegenerationJob {
  id        String   @id @default(cuid())
  status    String   // running | completed | failed
  total     Int      @default(0)
  generated Int      @default(0)
  durationMs Int     @default(0)
  error     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, updatedAt])
}

/// Durable status for administrator AI bulk jobs. Job input is deliberately not
/// persisted because it may contain user-provided text; interrupted work is
/// retained as a visible failed record after restart.
model AiBulkJob {
  id         String   @id
  status     String
  total      Int
  completed  Int      @default(0)
  count      Int?
  result     String?
  error      String?
  createdAt  DateTime @default(now())
  finishedAt DateTime?

  @@index([status, createdAt])
}

/// SRS progress and synced study settings owned by a Telegram learner account.
model LearnerProgress {
  userId    String       @id
  user      TelegramUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  data      String
  revision  Int          @default(0)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
}

/// Images used by the picture-description trainer.
model Picture {
  id        String   @id @default(cuid())
  title     String?
  description String?
  dataUrl   String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// A learner account identified by a verified Telegram user ID.
model TelegramUser {
  id         String         @id @default(cuid())
  telegramId String         @unique
  isAdmin    Boolean        @default(false)
  isBanned   Boolean        @default(false)
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt
  challenges TelegramChallenge[]
  sessions   UserSession[]
  progress   LearnerProgress?
  reminderSettings ReminderSettings?
}

/// Per-learner Telegram reminder schedule and one-off snooze state.
model ReminderSettings {
  userId        String       @id
  user          TelegramUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  mode          String       @default("off") // off | incomplete | always
  times         String       @default("[\"09:00\"]")
  days          String       @default("[0,1,2,3,4,5,6]") // Sunday = 0
  timezone      String       @default("UTC")
  lastSentSlot  String?
  snoozeUntil   DateTime?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@index([mode, snoozeUntil])
}

/// One-time browser login challenge. Digests are stored instead of secrets.
model TelegramChallenge {
  id                    String       @id @default(cuid())
  codeDigest            String       @unique
  browserBindingDigest  String
  status                String       @default("pending")
  telegramUserId        String?
  telegramUser          TelegramUser? @relation(fields: [telegramUserId], references: [id], onDelete: Cascade)
  expiresAt             DateTime
  confirmedAt           DateTime?
  consumedAt            DateTime?
  createdAt             DateTime     @default(now())

  @@index([status, expiresAt])
  @@index([browserBindingDigest, status])
}

/// Opaque, revocable learner session. Only the token digest is persisted.
model UserSession {
  id         String      @id @default(cuid())
  userId     String
  user       TelegramUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenDigest String     @unique
  expiresAt  DateTime
  revokedAt  DateTime?
  createdAt  DateTime    @default(now())

  @@index([userId, expiresAt])
  @@index([expiresAt, revokedAt])
}
