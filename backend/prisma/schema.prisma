generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Category {
  id         String   @id @default(cuid())
  name       String
  normalizedName String?
  icon       String?
  color      String?
  isBuiltin  Boolean  @default(false)
  /// Words whose PRIMARY category this is (Word.categoryId).
  words      Word[]   @relation("PrimaryCategory")
  /// Words that additionally belong to this category (many-to-many).
  extraWords Word[]   @relation("WordExtraCategories")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  @@unique([normalizedName])
}

model Word {
  id              String   @id @default(cuid())
  de              String
  normalizedDe    String?
  ru              String
  hint            String?
  /// noun | verb | adjective | adverb | other. Validated in the API (SQLite has no enums in Prisma 5).
  /// null = not specified; the API infers it on save, see src/services/partOfSpeech.ts.
  partOfSpeech    String?
  plural          String?
  feminine        String?
  praeteritum     String?
  partizip2       String?
  hilfsverb       String?
  praesensIch     String?
  praesensDu      String?
  praesensErSieEs String?
  praesensWir     String?
  praesensIhr     String?
  praesensSie     String?
  /// Case typically required by the verb: nominativ | akkusativ | dativ | genitiv.
  requiredCase    String?
  /// PRIMARY category (the first of the word's categories). Kept as a plain column so existing data
  /// needs no migration; the rest of the word's categories are in `extraCategories`.
  categoryId      String
  category        Category   @relation("PrimaryCategory", fields: [categoryId], references: [id], onDelete: Cascade)
  /// Additional categories. The API exposes primary + extras as one list (`categories` / `categoryIds`).
  extraCategories Category[] @relation("WordExtraCategories")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  @@unique([normalizedDe])
}

model AnalyticsEvent {
  id          String   @id @default(cuid())
  eventType   String
  trainerType String?
  isCorrect   Boolean?
  /// Random id from the long-lived `visitor_id` cookie (see src/services/visitor.ts).
  /// null = event recorded before the cookie existed.
  visitorId   String?
  ipAddress   String?
  userAgent   String?
  browser     String?
  os          String?
  device      String?
  timestamp   DateTime @default(now())

  @@index([eventType, timestamp])
}

/// Server-wide settings edited in the admin panel (key → JSON-encoded value).
/// Currently: "srsBoxWeights" — see src/services/srsSettings.ts.
model Setting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

/// Safe diagnostic records for failed AI operations. Prompts, answers, images and API keys are never stored.
model AiErrorLog {
  id             String   @id @default(cuid())
  operation      String
  profileId      String?
  model          String?
  errorCode      String
  providerStatus Int?
  message        String
  durationMs     Int?
  createdAt      DateTime @default(now())

  @@index([createdAt])
  @@index([operation, createdAt])
}

/// Generated speech audio. The same table supports individual words today and
/// complete sentences later; `cacheKey` includes the text and TTS settings.
model AudioCache {
  id        String   @id @default(cuid())
  cacheKey  String   @unique
  kind      String   // word | sentence
  text      String
  audio     Bytes
  mimeType  String   @default("audio/wav")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([kind])
}

/// Durable status of the administrator's background word-audio regeneration.
/// There is at most one active job; progress survives a browser refresh.
model AudioRegenerationJob {
  id        String   @id @default(cuid())
  status    String   // running | completed | failed
  total     Int      @default(0)
  generated Int      @default(0)
  durationMs Int     @default(0)
  error     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, updatedAt])
}

/// SRS progress shared between a learner's devices through a sync key.
/// `keyHash` = sha256 of the key (the key itself is never stored); `data` = JSON snapshot,
/// see src/services/srsSync.ts.
model SyncProfile {
  keyHash   String   @id
  data      String
  /// Optimistic-lock revision used to prevent concurrent sync requests from overwriting each other.
  revision  Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// Images used by the picture-description trainer.
model Picture {
  id        String   @id @default(cuid())
  title     String?
  description String?
  dataUrl   String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
